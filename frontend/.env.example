# Copier en .env (ou .env.local) puis adapter.
# Seules les variables VITE_* sont exposées au navigateur par Vite.
# Les variables FIGMA_* sont lues uniquement par le script Node `npm run figma:icons`.

# URL du backend Python FastAPI (voir ../backend/README.md et ../docs/API-CONTRACT.md)
VITE_API_URL=http://localhost:8000

# true  = simulateur local uniquement (DÉMO, aucun appel réseau)
# false = vraie API ; si elle est injoignable, bascule automatique sur le simulateur (réessai toutes les 30 s)
VITE_USE_MOCK=false

# Authentification : vide = comptes de démonstration (DemoAuthService).
# Renseigner l’URL de l’API d’authentification pour activer HttpAuthService (POST /auth/login, /auth/logout).
VITE_AUTH_API_URL=

# true = pages de dev (?stillset, ?wtgrid…) aussi dans un build de production
VITE_DEV_TOOLS=

# IP du buzzer ESP32-C3 (Wi-Fi, Moniteur Série). Lue seulement par le serveur de dev.
# Mise de l’appareil, alarme rouge, scan visage → POST http://<ip>/bip
ESP_BUZZER_IP=192.168.137.11

# --- Pont Figma (Node seulement, jamais de préfixe VITE_) ---
# Jeton personnel : Figma → Settings → Security → Personal access tokens
# (portée en lecture du contenu du fichier). Laisser vide si le script n’est pas utilisé.
FIGMA_ACCESS_TOKEN=

# Clé du fichier : segment figma.com/design/<clé>/…
FIGMA_FILE_KEY=cj96CiSofo2y0mDSpre7J1

# Durée du cache local, en heures (0 = toujours retélécharger). Défaut 24.
# FIGMA_CACHE_TTL_HOURS=24

# Plafond d’icônes par exécution (défaut 100, max 2000).
# FIGMA_MAX_ICONS=100

# Liste optionnelle de nœuds, en plus de --ids et de scripts/figma/nodes.json.
# FIGMA_NODE_IDS=12:34,56:78
